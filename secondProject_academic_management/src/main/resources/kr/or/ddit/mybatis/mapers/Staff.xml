      <!-- 학생 정보 수정 (updateStudent) -->
   <update id="updateStudent" parameterType="StudentVO" >
   UPDATE STUDENT    
      SET                     
         STD_TELNO = #{stdTelno,jdbcType=VARCHAR}   
         , STD_ADDRESS = #{stdAddress,jdbcType=VARCHAR}        
      WHERE STD_NO= #{stdNo,jdbcType=VARCHAR} 
   </update>
       

   <!-- 교수 정보 수정 (updateProfessor) --> 
   <update id="updateProfessor" parameterType="ProfessorVO" >
   UPDATE PROFESSOR    
      SET                     
         PRO_TELNO = #{proTelno,jdbcType=VARCHAR}   
      WHERE PRO_NO= #{proNo,jdbcType=VARCHAR} 
   </update>
