<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.staff.dao.StaffDAO">

   <!-- 학생 검색 조건을 담은 SQL 프래그먼트 정의 -->

   <sql id="searchFrag">
		<where>
			<if
				test="@org.apache.commons.lang3.StringUtils@isNotBlank(simpleCondition.searchWord)">
				<choose>
					<when test="simpleCondition.searchType eq 'stdNo'">
						INSTR(STD_NO, #{simpleCondition.searchWord}) > 0
					</when>
					<when test="simpleCondition.searchType eq 'stdName'">
						INSTR(STD_NAME, #{simpleCondition.searchWord}) > 0
					</when>
					<when test="simpleCondition.searchType eq 'proNo'">
						INSTR(PRO_NO, #{simpleCondition.searchWord}) > 0
					</when>
					<otherwise>
						INSTR(STD_NO, #{simpleCondition.searchWord}) > 0
						OR
						INSTR(STD_NAME, #{simpleCondition.searchWord}) > 0
						OR
						INSTR(PRO_NO, #{simpleCondition.searchWord}) > 0
					</otherwise>
				</choose>
			</if>
		</where>
	</sql>
	
	<sql id="searchFrag2">
		<where>
			<if
				test="@org.apache.commons.lang3.StringUtils@isNotBlank(simpleCondition.searchWord)">
				<choose>
					<when test="simpleCondition.searchType eq 'proNo'">
						INSTR(PRO_NO,#{simpleCondition.searchWord}) > 0
					</when>
					<when test="simpleCondition.searchType eq 'proName'">
						INSTR(PRO_NAME,#{simpleCondition.searchWord}) > 0
					</when>
					<when test="simpleCondition.searchType eq 'proMajor'">
						INSTR(PRO_MAJOR,#{simpleCondition.searchWord}) > 0
					</when>
					<otherwise>
						INSTR(PRO_NO,#{simpleCondition.searchWord}) > 0
						OR
						INSTR(PRO_NAME,#{simpleCondition.searchWord}) > 0
						OR
						INSTR(PRO_MAJOR,#{simpleCondition.searchWord}) > 0
					</otherwise>
				</choose>
			</if>
		</where>
	</sql>


   <!-- 학생 총 레코드 수를 반환하는 쿼리 (selectTotalRecordStudent) -->
   <select id="selectTotalRecordStudent" resultType="int"
      parameterType="kr.or.ddit.common.paging.PaginationInfo">
      SELECT COUNT(*)
      FROM STUDENT
      <include refid="searchFrag" />
   </select>

   <!-- 학생 리스트를 반환하는 쿼리(selectStudentList) -->
   <select id="selectStudentList" resultType="StudentVO"
      parameterType="kr.or.ddit.common.paging.PaginationInfo">
      SELECT B.*
      FROM(
      SELECT ROWNUM RNUM, A.*
      FROM(
      SELECT STD_NO, STD_NAME,
      STD_ID, STD_TELNO, STD_ADDRESS,PRO_NO
      FROM STUDENT 
      <include refid="searchFrag" />
      ORDER BY STD_NO DESC
      ) A
      ORDER BY STD_NO
      ) B
      <![CDATA[
      WHERE RNUM >= #{startRow} AND RNUM <= #{endRow}
      ]]>
   </select>

   <!-- 학생 정보 조회 (selectStudent) -->
   <select id="selectStudent" resultType="StudentVO"
      parameterType="string">
      SELECT
      STD_NO, STD_NAME, STD_ID, STD_TELNO,
      STD_ADDRESS,PRO_NO
      FROM
      STUDENT
      WHERE
      STD_NAME = #{stdName}
   </select>

